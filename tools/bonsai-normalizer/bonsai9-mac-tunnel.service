[Unit]
Description=Forward only the Mac Bonsai9B loopback endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -NT -i %h/.ssh/bonsai9_tunnel_ed25519 -o IdentitiesOnly=yes -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ConnectTimeout=10 -L 127.0.0.1:18091:127.0.0.1:8091 slovn@100.116.97.112
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
