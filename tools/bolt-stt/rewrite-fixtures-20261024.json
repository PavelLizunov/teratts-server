        "conditional_check": "(?=.*проверк)(?=.*(?:если|после|при|успеш))",
        "28_records": "28\\s+запис",
        "16_seconds": "16\\s+сек",
        "retain_journal": "(?:не\\s+удаля[йт]|сохран|остав|не\\s+удалять)[^.!?]*журнал|журнал[^.!?]*(?:не\\s+удаля|сохран|остав)"
      },
      "forbidden_pattern": "бля[дт]|заеб|нахуй|сука|невыносим"
