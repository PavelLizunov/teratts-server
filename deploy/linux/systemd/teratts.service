[Unit]
Description=TeraTTSv2 loopback inference service
After=network.target
ConditionPathExists=/opt/teratts/current/teratts-server
ConditionPathIsDirectory=/var/lib/teratts/models/teratts-v2-f05ea799094571a3553904a555df3834fb0b963b

[Service]
Type=simple
User=teratts
Group=teratts
EnvironmentFile=/etc/teratts/teratts.env
EnvironmentFile=/opt/teratts/current/release.env
ExecStart=/opt/teratts/current/teratts-server --serve --host 127.0.0.1 --port 8088 --model-dir /var/lib/teratts/models
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

# ONNX Runtime may use mmap, executable mappings, threads, and CPU feature probes.
# Deliberately omit MemoryDenyWriteExecute and aggressive SystemCallFilter rules.
CPUAccounting=true
# CPUQuota=400% provides 4 full CPU cores (400ms per 100ms CFS quota period).
# Keep PARALLEL_CHUNKS=2 and ORT_THREADS=2 so active thread math does not exhaust
# CFS bandwidth and induce periodic scheduler throttling on Tokio and health probes.
CPUQuota=400%
MemoryAccounting=true
TasksAccounting=true
# TasksMax covers Tokio blocking pool, per-session ORT intra-op pools, and chunk workers.
TasksMax=512
LimitNOFILE=65536
# Baseline RSS with 2 slots is ~4.17 GiB. MemoryHigh=6500M and MemoryMax=7500M provide
# safe headroom for transient audio allocations without triggering kernel direct reclaim or OOM.
MemoryHigh=6500M
MemoryMax=7500M
MemorySwapMax=2G
# Watchdog note: teratts-server currently uses Type=simple. WatchdogSec is intentionally
# deferred until sd_notify("WATCHDOG=1") heartbeat support is compiled into the binary.

[Install]
WantedBy=multi-user.target
